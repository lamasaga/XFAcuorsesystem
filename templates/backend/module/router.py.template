"""
{{ModuleName}} API 路由
模块: {{module_name}}
"""
from fastapi import APIRouter, Depends, HTTPException, Query
from sqlalchemy.orm import Session
from typing import List, Optional

from app.core.dependencies import get_db, get_current_user
from app.common.response import success_response, paginate_response
from . import schemas, service
from .crud import {{module_name}}_crud

router = APIRouter(prefix="/{{module_name}}", tags=["{{ModuleNameCN}}"])


@router.get("/", response_model=schemas.{{ModelName}}ListResponse)
async def get_list(
    page: int = Query(1, ge=1, description="页码"),
    page_size: int = Query(20, ge=1, le=100, description="每页数量"),
    keyword: Optional[str] = Query(None, description="搜索关键词"),
    db: Session = Depends(get_db),
    current_user = Depends(get_current_user)
):
    """获取{{ModelNameCN}}列表"""
    items, total = await service.get_list(db, page, page_size, keyword)
    return paginate_response(items, total, page, page_size)


@router.get("/{id}", response_model=schemas.{{ModelName}}Response)
async def get_by_id(
    id: int,
    db: Session = Depends(get_db),
    current_user = Depends(get_current_user)
):
    """获取{{ModelNameCN}}详情"""
    item = await service.get_by_id(db, id)
    if not item:
        raise HTTPException(status_code=404, detail="{{ModelNameCN}}不存在")
    return success_response(item)


@router.post("/", response_model=schemas.{{ModelName}}Response)
async def create(
    data: schemas.{{ModelName}}Create,
    db: Session = Depends(get_db),
    current_user = Depends(get_current_user)
):
    """创建{{ModelNameCN}}"""
    item = await service.create(db, data)
    return success_response(item, message="创建成功")


@router.put("/{id}", response_model=schemas.{{ModelName}}Response)
async def update(
    id: int,
    data: schemas.{{ModelName}}Update,
    db: Session = Depends(get_db),
    current_user = Depends(get_current_user)
):
    """更新{{ModelNameCN}}"""
    item = await service.update(db, id, data)
    if not item:
        raise HTTPException(status_code=404, detail="{{ModelNameCN}}不存在")
    return success_response(item, message="更新成功")


@router.delete("/{id}")
async def delete(
    id: int,
    db: Session = Depends(get_db),
    current_user = Depends(get_current_user)
):
    """删除{{ModelNameCN}}"""
    success = await service.delete(db, id)
    if not success:
        raise HTTPException(status_code=404, detail="{{ModelNameCN}}不存在")
    return success_response(message="删除成功")


